---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** no header/footer, full-window body (used by /play/) */
  bare?: boolean;
}

const {
  title,
  description = 'Blocks of bricks are falling from the sky! Dodge them, push them, line them up and blow them away. A retro arcade game, free in your browser.',
  bare = false,
} = Astro.props;

const base = import.meta.env.BASE_URL; // "/paulo/"
const url = new URL(Astro.url.pathname, Astro.site);
const og = new URL(`${base}images/og.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d17" />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}favicon.png`} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Paulo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@kuragestudios" />
  </head>
  <body class:list={[{ bare }]}>
    {!bare && (
      <header class="site-header">
        <div class="container header-inner">
          <a class="brand" href={base}>
            <img src={`${base}images/icon.png`} alt="" width="36" height="36" />
            <span>Paulo</span>
          </a>
          <nav>
            <a href={`${base}#features`}>Features</a>
            <a href={`${base}#blocks`}>Blocks</a>
            <a href={`${base}#download`}>Download</a>
            <a class="btn btn-primary btn-small" href={`${base}play/`}>Play free</a>
          </nav>
        </div>
      </header>
    )}

    <slot />

    {!bare && (
      <footer class="site-footer">
        <div class="container footer-inner">
          <p>
            © {new Date().getFullYear()} <a href="https://www.kuragestudios.com" target="_blank" rel="noopener">Kurage Studios</a> · made in Japan
          </p>
          <p class="muted">
            <a href="https://kuragestudios.itch.io/paulo" target="_blank" rel="noopener">itch.io</a> ·
            <a href="https://play.google.com/store/apps/details?id=com.studiokurage.paulo" target="_blank" rel="noopener">Google Play</a> ·
            <a href="https://www.kuragestudios.com/press-kit/paulo/" target="_blank" rel="noopener">Press kit</a> ·
            <a href="mailto:kuragestudios@gmail.com">Contact</a>
          </p>
        </div>
      </footer>
    )}
  </body>
</html>

<style>
  body.bare { height: 100dvh; overflow: hidden; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 13, 23, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.7rem 0; }
  .brand { display: flex; align-items: center; gap: 0.6rem; color: var(--text); font-weight: 700; }
  .brand img { border-radius: 8px; }
  .brand:hover { text-decoration: none; }
  nav { display: flex; align-items: center; gap: 1.2rem; font-size: 0.95rem; }
  nav a { color: var(--muted); }
  nav a:hover { color: var(--text); text-decoration: none; }
  .btn-small { padding: 0.55em 1.1em; font-size: 0.75rem; color: var(--bg); }
  @media (max-width: 640px) { nav a:not(.btn) { display: none; } }

  .site-footer { border-top: 1px solid var(--line); padding: 2rem 0; font-size: 0.9rem; }
  .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
  .footer-inner p { margin: 0; }
</style>
